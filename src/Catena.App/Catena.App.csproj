<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0-windows10.0.19041.0</TargetFramework><SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion><ApplicationManifest>app.manifest</ApplicationManifest></PropertyGroup>
  <PropertyGroup><OutputType>WinExe</OutputType><AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault><ApplicationIcon>Assets/catena.ico</ApplicationIcon><Version>0.6.2</Version></PropertyGroup>
  <ItemGroup><AvaloniaResource Include="Assets/catena-64.png" /><AvaloniaResource Include="Assets/catena.ico" /><AvaloniaResource Include="Assets/blue-mist.png" /></ItemGroup>
  <ItemGroup>
    <Content Include="Assets/ThirdParty/*LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="../Catena.Core/Catena.Core.csproj" />
    <ProjectReference Include="../Catena.AI/Catena.AI.csproj" />
    <ProjectReference Include="../Catena.Search.Everything/Catena.Search.Everything.csproj" />
    <ProjectReference Include="../Catena.Storage.Local/Catena.Storage.Local.csproj" />
    <ProjectReference Include="../Catena.Persistence/Catena.Persistence.csproj" />
    <ProjectReference Include="../Catena.Platform.Windows/Catena.Platform.Windows.csproj" />
    <PackageReference Include="Avalonia" /><PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" /><PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../vendor/everything/es.exe" Condition="Exists('../../vendor/everything/es.exe')" Link="tools/everything/es.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../vendor/everything/LICENSE.txt" Link="tools/everything/LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../vendor/everything/Everything-Setup.exe" Condition="Exists('../../vendor/everything/Everything-Setup.exe')" Link="tools/everything/Everything-Setup.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../vendor/everything/Everything-License.txt" Link="tools/everything/Everything-License.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="ExcludePublishSymbols" AfterTargets="ComputeFilesToPublish">
    <ItemGroup><ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" /></ItemGroup>
  </Target>
</Project>
